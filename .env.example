# Copy this file to .env and fill in your own values. Never commit .env.

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: override the model Minuta uses
CLAUDE_MODEL=claude-sonnet-5-5

# Linear (Settings -> Security & access -> Personal API keys)
LINEAR_API_KEY=

# Granola (direct mode, Business/Enterprise plans): Settings -> Connectors -> API keys
GRANOLA_API_KEY=
# Direct mode looks for notes created in the last N hours (duplicates are skipped automatically)
LOOKBACK_HOURS=24

# Zapier mode only. Shared secret. Zapier sends it in the "x-minuta-secret" header so strangers can't post to your webhook.
MINUTA_WEBHOOK_SECRET=change-me

# Set to true to create every task with a "Needs review" label and no assignee,
# so the person who ran the call checks them before the team sees them.
REVIEW_MODE=false

# Tasks Claude is less sure about than this (0 to 1) are always flagged for review.
MIN_CONFIDENCE=0.6

# Set to true to run everything except creating the Linear issues (prints them instead).
DRY_RUN=false

# Port for the local server (npm start)
PORT=8787
